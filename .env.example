# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ─── MySQL (XAMPP defaults) ───────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=voltmap

# Connection pool
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# ─── Auth / JWT ───────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_please_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_please_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── Security ─────────────────────────────────────────────
COOKIE_SECRET=change_me_cookie_secret_please_at_least_32_chars
CSRF_ENABLED=true

# ─── Rate limit ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── OTP ──────────────────────────────────────────────────
OTP_TTL_SEC=120
OTP_RESEND_COOLDOWN_SEC=60
OTP_MAX_ATTEMPTS=5
OTP_CODE_LENGTH=5

# شماره ادمین پیش‌فرض (seed) — با همین شماره OTP بگیرید
ADMIN_PHONE=09120000000

# ─── sms.ir ───────────────────────────────────────────────
# ۱) در پنل sms.ir → برنامه‌نویسان → «کلید API» بسازید و اینجا بگذارید
SMS_IR_API_KEY=
# ۲) در پنل → ارسال سریع → یک قالب OTP بسازید (مثلاً: کد ورود شما: #CODE#)
#    بعد از تأیید قالب، شناسه عددی آن را اینجا بگذارید
SMS_IR_TEMPLATE_ID=
# ۳) نام پارامتر داخل قالب بدون # (معمولاً CODE)
SMS_IR_TEMPLATE_PARAM=CODE
# ۴) برای ارسال واقعی true کنید؛ اگر false باشد کد در لاگ سرور چاپ می‌شود (مناسب توسعه)
SMS_IR_ENABLED=false

# ─── Routing (فاصله رانندگی) ─────────────────────────────
# totalDist طول مسیر ماشین روی جاده است، نه خط مستقیم بین دو نقطه.
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=8000

# ─── Storage (عکس ایستگاه) ───────────────────────────────
# فایل‌ها اینجا ذخیره می‌شوند. در دیتابیس فقط مسیر نسبی می‌ماند، مثل stations/<id>.jpg
# آدرس نمایش در فرانت: http://localhost:4000/uploads + / + همان مسیر
STORAGE_DIR=storage
