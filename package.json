{
  "name": "voltmap-backend",
  "version": "1.0.0",
  "private": true,
  "description": "VoltMap Backend - Node.js + Express + MySQL (Hexagonal Architecture)",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "db:migrate": "node src/infrastructure/database/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:seed-stations": "node scripts/seed-stations.js",
    "db:seed-cars": "node scripts/seed-cars.js",
    "db:reset": "npm run db:migrate && npm run db:seed && npm run db:seed-stations && npm run db:seed-cars",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "mysql2": "^3.23.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
